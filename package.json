{
  "name": "buddy",
  "version": "0.1.0",
  "description": "Buddy — a touch-first learning game for Lower KG (ages 4–5)",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "node --import tsx scripts/validate-content.ts",
    "inspect": "node --import tsx scripts/inspect-round.ts",
    "voice": "node --import tsx scripts/gen-voice.ts",
    "check": "npm run typecheck && npm run test && npm run validate"
  },
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "dependencies": {
    "dexie": "^4.4.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
