{
  "name": "buddy",
  "version": "0.1.0",
  "description": "Buddy — a touch-first learning game for Lower KG (ages 4–5)",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "validate": "node --import tsx scripts/validate-content.ts",
    "inspect": "node --import tsx scripts/inspect-round.ts",
    "voice": "node --import tsx scripts/gen-voice.ts",
    "check": "npm run typecheck && npm run test && npm run validate",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prebuild": "npm run validate",
    "art": "node --import tsx scripts/fetch-art.ts",
    "icons": "node --import tsx scripts/make-icons.ts",
    "dev:tablet": "vite --host --mode tablet"
  },
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "dependencies": {
    "@fontsource/andika": "^5.3.0",
    "dexie": "^4.4.6",
    "howler": "^2.2.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
